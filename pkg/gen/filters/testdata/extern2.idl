module demo.x

// blank external type
extern XType1

// external type imported from another module
@go.module: "demo/x"
@cpp.name: "XType2"
@cpp.namespace: "demo::x"
@cpp.include: "x.h"
@py.module: "demo.x"
@java.package: "demo.x"
@cs.name: "XType2"
@cs.namespace: "Demo.X"
extern XType2

// external type imported from another module with alias
@go.module: "demo/x"
@go.name: "XType3A"
@cpp.name: "XType3A"
@cpp.namespace: "demo::x"
@cpp.include: "x.h"
@cpp.default: "demo::x::XtypeFactory::create()"
@py.module: "demo.x"
@py.name: "XType3A"
@java.package: "demo.x"
@java.name: "XType3A"
@cs.name: "XType3A"
@cs.namespace: "Demo.X"
@cs.default: "Demo.X.XTypeFactory.Create()"
extern XType3